
PROJECT_NAME=Medici
HOST=0.0.0.0
PORT=8000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:8501,http://localhost:5173

PROJECT_ID=your-gcp-project-id
LOCATION=us-central1
GCP_DOC_AI_LOCATION=us
GCP_DOC_AI_PROCESSOR_ID=your-processor-id
GCP_RAW_BUCKET=your-raw-bucket
GCP_PROCESSED_BUCKET=your-processed-bucket
VPC_CONNECTOR=your-vpc-connector

GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

CEREBRAS_API_KEY=your-cerebras-api-key
CEREBRAS_MODEL=llama3.1-70b

OPEN_ROUTER_API_KEY=your-openrouter-api-key

QDRANT_COLLECTION_NAME=rag_docs
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_CLUSTER_ENDPOINT=https://your-cluster.qdrant.io
QDRANT_DENSE_MODEL=BAAI/bge-base-en-v1.5
QDRANT_SPARSE_MODEL=Qdrant/bm25

LOGFIRE_TOKEN=your-logfire-token

LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=studious

# When running locally (outside Docker):
REDIS_URL=redis://localhost:6379
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=studious
POSTGRES_CONN_STRING=postgresql://postgres:postgres@postgres:5432/studious

# When running inside Docker Compose these are overridden automatically:
#   REDIS_URL=redis://redis:6379
#   POSTGRES_CONN_STRING=postgresql://postgres:postgres@postgres:5432/studious

EMBEDDING_MODEL_NAME=text-embedding-004
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=100
EMBEDDING_CACHE_ENABLED=true

VECTOR_SIZE=768
MAX_RETRIEVAL_ROUND=2
USE_PARENT_CONTEXT=true
SKIP_EXPANSION_CATEGORIES=factual

MAX_UPLOAD_BYTES=50
MAX_PAGE_PER_PARSE=20
INGESTION_ROOT=/app/data

TABLE_MODE=Fast
DO_TABLES=False
DO_OCR=False

SECRET_KEY=change-me-in-production
ALGORITHM=HS256

RATE_LIMIT_ENABLED=true

RATE_LIMIT_QUERY_MAX_REQUESTS=30
RATE_LIMIT_QUERY_WINDOW_SECONDS=60

RATE_LIMIT_INGESTION_MAX_REQUESTS=20
RATE_LIMIT_INGESTION_WINDOW_SECONDS=60

RATE_LIMIT_LOGIN_MAX_REQUESTS=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60

# Set FAITHFULNESS_ENABLED=false to bypass the gate entirely (e.g. in dev).
FAITHFULNESS_ENABLED=true
# Score threshold in [0, 1]. 0.5 is a sensible starting point; raise to 0.75+
FAITHFULNESS_THRESHOLD=0.5
# HuggingFace model ID for the NLI scorer.  Change only if you want to swap
FAITHFULNESS_MODEL=vectara/hallucination_evaluation_model
